{
  "name": "@repolain/core",
  "version": "0.1.4",
  "description": "Core scanning, detection, mapping, knowledge matching, explanation, and indexing engine for Repolain.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wazzysky/codee.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/wazzysky/codee",
  "bugs": {
