{
  "name": "repolain",
  "version": "0.1.4",
  "description": "CLI-first repository understanding tool for scanning, summarizing, mapping, and indexing codebases.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wazzysky/codee.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/wazzysky/codee",
  "bugs": {
    "url": "https://github.com/wazzysky/codee/issues"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "bin": {
    "repolain": "dist/bin.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm run build"
  },
  "keywords": [
    "cli",
    "repository",
    "analysis",
    "typescript",
    "codebase"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@repolain/core": "workspace:*",
    "commander": "^13.1.0"
  }
